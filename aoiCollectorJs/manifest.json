{
  "manifest_version": 3,
  "name": "AOI 采集工具",
  "version": "1.0.0",
  "description": "从高德地图网页版半自动采集建筑物AOI边界，存入本地数据库",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://gaode.com/*",
    "https://*.gaode.com/*",
    "https://amap.com/*",
    "https://*.amap.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gaode.com/*", "https://*.gaode.com/*", "https://amap.com/*", "https://*.amap.com/*"],
      "js": ["libs/coord.js", "hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gaode.com/*", "https://*.gaode.com/*", "https://amap.com/*", "https://*.amap.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["excel/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
